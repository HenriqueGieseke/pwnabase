#!/usr/bin/env python3
"""Linux repository checks. No downloads, fixes, or production-data processing."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time


class CheckFailure(Exception):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class Interrupted(Exception):
    def __init__(self, signum):
        self.signum = signum


def interrupt(signum, frame):
    raise Interrupted(signum)


def command(argv, cwd, env, capture=False, output=None):
    process = subprocess.Popen(argv, cwd=cwd, env=env, start_new_session=True,
                               stdout=output if output is not None else subprocess.PIPE if capture else None, text=True)
    try:
        output, _ = process.communicate()
        return process.returncode, output or ''
    except BaseException:
        # Ignore additional cancellation signals until the child's group is gone.
        handlers = {sig: signal.signal(sig, signal.SIG_IGN) for sig in (signal.SIGINT, signal.SIGTERM)}
        try:
            try:
                os.killpg(process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass
            # A group member may outlive its leader, including one holding an
            # inherited output pipe open. Reap the group even if wait succeeded.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
        finally:
            for sig, handler in handlers.items():
                signal.signal(sig, handler)
        raise


def require(argv, cwd, env, capture=False, output=None):
    code, result = command(argv, cwd, env, capture, output)
    if code:
        raise CheckFailure(f'{Path(argv[0]).name} failed (exit {code})', code if code > 0 else 1)
    return result


def compatible(version, policy):
    """Support the stable caret/minimum alternatives used by this project's manifest."""
    alternatives = []
    for part in policy.split('||'):
        match = re.fullmatch(r'\s*(\^|>=)(\d+)\.(\d+)\.(\d+)\s*', part)
        if not match:
            raise CheckFailure(f'Unsupported Node engine policy: {policy}; update the check runner')
        operator, *numbers = match.groups()
        minimum = tuple(map(int, numbers))
        if operator == '^' and minimum[0] == 0:
            raise CheckFailure('Node caret policy must use a nonzero major version')
        alternatives.append(version >= minimum and (operator == '>=' or version[0] == minimum[0]))
    return any(alternatives)


def select_node(root, runtime_root, env):
    policy = json.loads((root / 'frontend/package.json').read_text())['engines']['node']
    local = runtime_root / 'frontend/.runtime/node_modules/node/bin/node'
    installed = shutil.which('node', path=env.get('PATH'))
    for candidate in [str(local), installed]:
        if not candidate or not os.access(candidate, os.X_OK):
            continue
        code, output = command([candidate, '--version'], root, env, capture=True)
        match = re.fullmatch(r'v(\d+)\.(\d+)\.(\d+)\s*', output)
        if not code and match and compatible(tuple(map(int, match.groups())), policy):
            return Path(candidate).absolute()
    raise CheckFailure(f'No compatible Node found (required: {policy}). Install a compatible runtime before checking; nothing was downloaded.')


def export_index(git, repository, destination, env):
    entries = require([git, 'ls-files', '--stage', '-z'], repository, env, capture=True)
    files = []
    for entry in entries.split('\0'):
        if not entry:
            continue
        metadata, name = entry.split('\t', 1)
        mode, object_id, stage = metadata.split()
        if stage != '0':
            raise CheckFailure('Resolve unmerged index entries before staged checks')
        if mode not in {'100644', '100755'}:
            raise CheckFailure(f'Staged checks do not support symlinks or submodules: {name!r}')
        files.append((mode, object_id, name))
    visible = require([git, 'diff', '--cached', '--name-only', '--ita-visible-in-index', '-z'], repository, env, capture=True)
    hidden = require([git, 'diff', '--cached', '--name-only', '--ita-invisible-in-index', '-z'], repository, env, capture=True)
    if visible != hidden:
        raise CheckFailure('Stage or remove intent-to-add entries before staged checks')
    destination.mkdir()
    for mode, object_id, name in files:
        target = destination / name
        if not target.resolve().is_relative_to(destination):
            raise CheckFailure(f'Invalid staged path: {name!r}')
        target.parent.mkdir(parents=True, exist_ok=True)
        # Read blobs directly: checkout-index would apply working-tree attributes
        # and smudge/line-ending filters, potentially changing the staged bytes.
        with target.open('wb') as stream:
            require([git, 'cat-file', 'blob', object_id], repository, env, output=stream)
        target.chmod(0o755 if mode == '100755' else 0o644)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--real-tools', action='store_true', help='Explicitly enable synthetic Hashcat/extractor integrations')
    parser.add_argument('--staged', action='store_true', help='Check an isolated export of the Git index')
    args = parser.parse_args()
    stage = 'prerequisites'
    started = time.monotonic()
    try:
        if sys.platform != 'linux':
            raise CheckFailure('Repository checks currently support Linux only')
        if sys.version_info < (3, 10):
            raise CheckFailure('Python 3.10+ is required; install it before checking')
        repository = Path(__file__).absolute().parents[1].resolve()
        env = os.environ.copy()
        env['GIT_OPTIONAL_LOCKS'] = '0'
        git = shutil.which('git')
        if not git:
            raise CheckFailure('Git is required; install it before checking')
        top = require([git, 'rev-parse', '--show-toplevel'], repository, env, capture=True).strip()
        if Path(top).resolve() != repository:
            raise CheckFailure('Run the check command from its repository checkout')
        with tempfile.TemporaryDirectory(prefix='pwnabase-check-') as directory:
            temporary = Path(directory)
            root = repository
            if args.staged:
                stage = 'staged snapshot'
                export_index(git, repository, temporary / 'snapshot', env)
                root = temporary / 'snapshot'
            stage = 'prerequisites'
            node = select_node(root, repository, env)
            print(f'Python: {sys.executable}; Node: {node}', flush=True)
            # Give every child the same Node, including tests launching it by name.
            bin_path = temporary / 'bin'
            bin_path.mkdir()
            (bin_path / 'node').symlink_to(node)
            child_env = env.copy()
            child_env['PATH'] = str(bin_path) + os.pathsep + env.get('PATH', '')
            child_env['RUN_REAL_TOOLS'] = '1' if args.real_tools else '0'
            child_env['PYTHONPYCACHEPREFIX'] = str(temporary / 'bytecode')
            child_env['PYTHONPATH'] = str(root)
            # A Git hook exports repository-local variables. Fixture repositories
            # in the tests must not inherit the real checkout's index or Git dir.
            for name in require([git, 'rev-parse', '--local-env-vars'], repository, env, capture=True).splitlines():
                child_env.pop(name, None)
            stage = 'whitespace'
            print(f'Checking {stage}...', flush=True)
            if not args.staged:
                require([git, 'diff', '--check'], repository, env)
            require([git, 'diff', '--cached', '--check'], repository, env)
            stage = 'Python compilation'
            print(f'Checking {stage}...', flush=True)
            sources = [root / 'recover.py', *sorted((root / 'pwnabase').glob('*.py')),
                       *sorted((root / 'tests').glob('*.py')), root / 'scripts/check']
            sources.extend(path for path in [root / 'scripts/install-hooks', root / '.githooks/pre-commit'] if path.exists())
            require([sys.executable, '-m', 'py_compile', *map(str, sources)], root, child_env)
            stage = 'Python tests'
            print(f'Checking {stage}...', flush=True)
            require([sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-v'], root, child_env)
            stage = 'frontend result-reader tests'
            print(f'Checking {stage}...', flush=True)
            require([str(node), 'frontend/tests/sheets.test.mjs'], root, child_env)
        print(f'All checks passed ({time.monotonic() - started:.1f}s).', flush=True)
        return 0
    except Interrupted as exc:
        print(f'Interrupted during {stage}; checks stopped.', file=sys.stderr)
        return 128 + exc.signum
    except (CheckFailure, OSError, ValueError, KeyError) as exc:
        print(f'FAILED: {stage}: {exc}', file=sys.stderr)
        return exc.code if isinstance(exc, CheckFailure) else 1


if __name__ == '__main__':
    signal.signal(signal.SIGINT, interrupt)
    signal.signal(signal.SIGTERM, interrupt)
    sys.exit(main())
