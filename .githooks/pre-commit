#!/usr/bin/env python3
"""Run the staged check runner, even when its working copy differs."""

from pathlib import Path
import subprocess
import sys

try:
    root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
    source = subprocess.check_output(['git', 'show', ':scripts/check'])
except (OSError, subprocess.CalledProcessError) as exc:
    print(f'Cannot load staged check runner: {exc}', file=sys.stderr)
    sys.exit(1)

filename = str(root / 'scripts/check')
sys.argv = [filename, '--staged']
exec(compile(source, filename, 'exec'), {'__name__': '__main__', '__file__': filename})
